# URL da API do Bagre (sem barra final)
BAGRE_API_URL=http://localhost:3001

# Token de automação gerado em Admin → API Tokens.
# Para o MVP use um token de escopo READ_ONLY: o agente consegue consultar,
# mas a própria API bloqueia qualquer escrita (403). Segurança em primeiro lugar.
BAGRE_API_TOKEN=bagre_cole_seu_token_aqui

# (opcional) Idempotência: janela em ms para reusar respostas de leitura idênticas
# e evitar loops caros do agente. 0 desliga. Padrão: 5000.
# BAGRE_MCP_CACHE_TTL_MS=5000
